{
  "name": "rnscommerce/mftf-webdriver-bidi",
  "description": "MFTF's MagentoWebDriver with its page waits answered by WebDriver BiDi readiness, through codeception-module-webdriver-bidi.",
  "type": "library",
  "license": "MIT",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/rnscommerce/php-webdriver-bidi"
    },
    {
      "type": "vcs",
      "url": "https://github.com/rnscommerce/codeception-module-webdriver-bidi"
    }
  ],
  "require": {
    "php": "^8.2",
    "magento/magento2-functional-testing-framework": "^5.0 || ^6.0",
    "rnscommerce/codeception-module-webdriver-bidi": "^0.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "phpstan/phpstan": "^2",
    "squizlabs/php_codesniffer": "^3"
  },
  "autoload": {
    "psr-4": {
      "Rnscommerce\\Mftf\\BiDi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rnscommerce\\Mftf\\BiDi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit --testsuite integration",
    "stan": [
      "codecept build --config tests/Integration/Project --quiet",
      "phpstan analyse"
    ],
    "cs": "phpcs",
    "cs-fix": "phpcbf",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  }
}
